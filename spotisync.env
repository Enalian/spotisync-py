# =====================================================================
# 1. SPOTIFY И ПЛЕЙЛИСТ
# =====================================================================
# Ссылка на открытый (или доступный по ссылке с pt=...) плейлист Spotify, либо его 22-символьный ID
PLAYLIST_URL=https://open.spotify.com/playlist/...

# Регион (ISO-код страны) для проверки доступности треков в Spotify и поиска годов в Apple Music / iTunes
SPOTIFY_MARKET=US

# Отсеивать недоступные (серые), пустые, локальные и изъятые правообладателями треки из плейлиста
FILTER_UNAVAILABLE_SPOTIFY=true


# =====================================================================
# 2. РАСПИСАНИЕ, ПУТИ, БАЗА ДАННЫХ И СИНХРОНИЗАЦИЯ
# =====================================================================
# Интервал проверки плейлиста В МИНУТАХ (0 = выполнить один цикл синхронизации и завершиться)
SYNC_INTERVAL_MINUTES=1440

# Путь к папке с музыкой внутри контейнера.
# В AzuraCast том станции обычно монтируется как /var/azuracast/stations/<short_name>/media:/music
OUTPUT_DIR=/var/azuracast/stations/spotify_music/media

# Временная папка для атомарной закачки и конвертации FFmpeg (чтобы AzuraCast не подхватывал недокачанные файлы)
STAGING_DIR=/tmp/spotisync_staging

# Имя файла локального кэша метаданных и состояния синхронизации (лежит внутри OUTPUT_DIR)
CACHE_FILENAME=.spotisync.json

# Имя файла ручного управления треками внутри OUTPUT_DIR (содержит разделы ignores, overrides и custom_tracks)
CUSTOM_TRACKS_FILENAME=.spotitracks.json

# Удалять ли с диска и из плейлиста AzuraCast треки, которые были удалены из плейлиста Spotify или добавлены в ignores
SYNC_DELETE_REMOVED=true

# Права владельца (UID и GID) для создаваемых MP3 и файлов кэша (по стандарту в AzuraCast это 1000:1000)
PUID=1000
PGID=1000


# =====================================================================
# 3. ПОИСК, YT-DLP, АДАПТИВНЫЙ WATCHDOG, КАРАНТИН И КУКИ
# =====================================================================
# Сколько треков искать, качать и конвертировать одновременно (оптимально 3–5, чтобы не перегружать CPU и сеть)
CONCURRENT_DOWNLOADS=5

# Количество попыток скачивания со сменой профиля клиента (ios+mweb -> tv_embedded+mweb -> web_creator+android_vr+tv_embedded)
YTDLP_RETRIES=3

# Таймаут сетевого сокета yt-dlp в секундах при установке соединения
YTDLP_SOCKET_TIMEOUT_SEC=30

# Базовый таймаут на попытку скачивания трека в секундах (адаптивный Watchdog автоматически продлевает его по ETA)
WORKER_TIMEOUT_SEC=360

# Таймаут на один поисковый запрос (ISRC / Topic / YouTube / SoundCloud) в секундах
WORKER_SEARCH_STEP_TIMEOUT_SEC=180

# Сколько секунд поток скачивания может висеть вообще без новых данных до принудительного сброса
WORKER_STALL_TIMEOUT_SEC=120

# Абсолютный потолок времени (в секундах) на один этап работы воркера при экстремально медленной сети
WORKER_MAX_HARD_TIMEOUT_SEC=1500

# Минимальная расчетная скорость (KB/s) для формулы адаптивного таймера Watchdog
MIN_ACCEPTABLE_SPEED_KBPS=10

# Базовый максимальный срок карантина в часах (0 = отключить карантин).
# Умный карантин сам выбирает срок: 1–12ч при сетевых таймаутах, от 6ч при ошибках форматов/403, от 24ч если трек не найден
FAIL_TTL_HOURS=72
FAILED_CACHE_FILE=/app/data/failed_tracks.json

# Путь к файлу куки YouTube в формате Netscape (настраивается и проверяется через флаг --auth)
YT_COOKIE_FILE=/app/data/cookies.txt

# Внутренний адрес контейнера генерации PO-токенов (bgutil-ytdlp-pot-provider для обхода защит YouTube)
POT_PROVIDER_URL=http://spotisync_pot:4416

# Если файла нет на диске — игнорировать старую ссылку из кэша и искать лучший источник заново
IGNORE_CACHED_URLS=true

# Если прямая ссылка из .spotitracks.json (overrides) недоступна или гео-заблокирована на сервере —
# автоматически переходить к каскадному поиску (ISRC -> Topic -> YouTube / SoundCloud), а не кидать в карантин
DIRECT_URL_FALLBACK=true

# Разрешить Уровень 4 («фоллбэк последнего шанса»): если строгие уровни 1–3 (ISRC, Topic, балльный каскад)
# ничего не нашли — брать первое подходящее по длительности видео с YouTube по полному названию
ENABLE_FALLBACK_SEARCH=true

# Разрешить команде --track скачивать сторонние треки, которых нет в вашем плейлисте Spotify и локальном кэше
TRACK_ALLOW_EXTERNAL=false


# =====================================================================
# 4. РАДИО-ОБРАБОТКА ЗВУКА (FFMPEG МАСТЕРИНГ)
# =====================================================================
# Выравнивать ли громкость всех треков под радио-стандарт EBU R128 (-14 LUFS, 44.1kHz, 320kbps MP3)
AUDIO_NORMALIZE=true

# Мягко обрезать ли цифровую тишину (-72dB) в начале и конце трека (чтобы не ломать кроссфейды на радио)
AUDIO_TRIM_SILENCE=true


# =====================================================================
# 5. ЛОГИРОВАНИЕ И ОТЛАДКА
# =====================================================================
# Основной уровень логирования: TRACE, DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO

# Цветное ANSI-оформление логов в консоли (для docker logs -f)
LOG_COLORS=true

# Запись логов в файл с авторотацией (до 15 МБ x 5 файлов). Оставь пустым, если хватает docker logs
LOG_FILE=/app/data/spotisync.log

# --- Точечные переключатели детализации (работают даже при LOG_LEVEL=INFO) ---
# Выводить полный список всех спарсенных треков со Spotify (номер, год, альбом, длительность, ISRC, имя файла)
LOG_SHOW_PARSED_TRACKS=true

# Выводить математику скоринга (баллы кандидатов и причины отбраковки ремиксов/каверов/неверной длины)
LOG_SHOW_SCORING=false

# Выводить сообщение [SKIP] для каждого трека, который уже скачан и лежит на диске
LOG_SHOW_SKIPPED=false

# Выводить список проблемных треков, пропускаемых из-за активного карантина (с остатком времени и причиной)
LOG_SHOW_QUARANTINE=true

# Выводить прогресс скачивания каждого файла (шаги 25% / 50% / 75% / 100%, скорость потока и ETA)
LOG_DOWNLOAD_PROGRESS=true


# =====================================================================
# 6. ИНТЕГРАЦИЯ С AZURACAST API (ОПЦИОНАЛЬНО)
# =====================================================================
# Работает автоматически, если заполнены URL, API_KEY, STATION_ID и указан PLAYLIST_ID (или PLAYLIST_NAME).
# Для проверки связи и просмотра всех ID станций/плейлистов запустите скрипт с флагом --azura-check
AZURACAST_URL=http://azuracast
AZURACAST_API_KEY=

# Можно указать числовой ID станции (например, 1), её системный short_name (например, spotify_music) или название
AZURACAST_STATION_ID=

# Можно указать числовой ID плейлиста ИЛИ его название в AzuraCast:
AZURACAST_PLAYLIST_ID=
AZURACAST_PLAYLIST_NAME=default

# Если OUTPUT_DIR смонтирован НЕ в корень папки media станции, а во вложенную подпапку (например, media/spotify),
# укажите относительный путь этой подпапки (оставьте пустым, если треки лежат в корне media)
AZURACAST_MEDIA_SUBDIR=

