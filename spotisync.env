# ========================================================
# Настройки SpotiSync v7.3.19-MODERN (Pydantic / Nuitka)
# ========================================================

# --- ОСНОВНЫЕ НАСТРОЙКИ (SPOTIFY И СИНХРОНИЗАЦИЯ) ---
# URL или ID плейлиста Spotify
PLAYLIST_URL=https://open.spotify.com/playlist/ТВОЙ_ПЛЕЙЛИСТ
SPOTIFY_MARKET=US

# [НОВОЕ] Интервал синхронизации в часах (минимум 1.0)
SYNC_INTERVAL_HOURS=24

# Удалять ли скачанные MP3, если их убрали из плейлиста Spotify?
SYNC_DELETE_REMOVED=false

# Фильтровать "серые" (недоступные) и локальные треки в плейлисте Spotify
FILTER_UNAVAILABLE_SPOTIFY=true

# Разрешить ручное скачивание через CLI (--track) треков вне кэша/плейлиста
TRACK_ALLOW_EXTERNAL=false


# --- ОБРАБОТКА АУДИО (FFMPEG) ---
# Мягкая обрезка цифровой тишины в начале и конце (-72dB)
AUDIO_TRIM_SILENCE=true
# Нормализация громкости всех треков
AUDIO_NORMALIZE=true
# [НОВОЕ] Целевой уровень громкости (стандарт вещания = -14 LUFS)
AUDIO_TARGET_LUFS=-14


# --- AZURACAST (Оставьте пустыми, если не используете) ---
# Базовый URL сервера AzuraCast (например, https://radio.example.com)
AZURACAST_URL=
# API Ключ (с правами на управление медиа и плейлистами)
AZURACAST_API_KEY=
# ID станции (число) или short_name (например, spotify_radio)
AZURACAST_STATION_ID=
# ID плейлиста (число) или его точное Имя
AZURACAST_PLAYLIST_ID=
AZURACAST_PLAYLIST_NAME=
# Подпапка внутри медиа директории AzuraCast (опционально)
AZURACAST_MEDIA_SUBDIR=


# --- СКАЧИВАНИЕ И ПРОИЗВОДИТЕЛЬНОСТЬ (YT-DLP) ---
# Количество одновременных потоков скачивания
CONCURRENT_DOWNLOADS=5
YTDLP_RETRIES=3

# Защита от зависших потоков: если скорость < 10 КБ/с дольше 120 секунд — убить сокет
WORKER_STALL_TIMEOUT_SEC=120
MIN_ACCEPTABLE_SPEED_KBPS=10

# Фоллбэки
DIRECT_URL_FALLBACK=true
ENABLE_FALLBACK_SEARCH=true

# Карантины (в часах). Треки с ошибками пропускаются указанное время, чтобы не банить IP
FAIL_TTL_HOURS=72
META_FAIL_TTL_HOURS=24

# Если используете PoT (Proof of Work) провайдер для обхода блокировок YouTube
# POT_PROVIDER_URL=http://your-pot-provider:8080/


# --- ЛОГИРОВАНИЕ И ИНТЕРФЕЙС ---
LOG_LEVEL=INFO

# [НОВОЕ] Включить запись логов в файлы (spotisync.log и spotisync_error.log)
ENABLE_LOGS=true
# [НОВОЕ] Тихий режим: в консоль летит только WARNING и ERROR (а в файлы — всё)
LOG_QUIET=false

# Цвета в консоли
LOG_COLORS=true
